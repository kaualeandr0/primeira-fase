programa {
  funcao inicio() {
    //entendimento do problema
    //calcular o horário de retorno do recreio
    //infos e variaveis
    inteiro hora, minuto
    // entrada de dados
    escreva("hora do começo: ")
    leia(hora)
    escreva("minuto do começo: ")
    leia (minuto)
    //processamento
    minuto = minuto + 20
    //saída
    escreva ("recreio termina ")
    escreva(hora)
    escreva(":")
    escreva(minuto)
    // escreva ("o que acontece com quem chega depois do horario")

  }
}
