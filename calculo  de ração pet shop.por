programa {
  funcao inicio() {
    //entendimento
      //calcular o preço por gramas
    //infos e variaveis
    real preco, peso
    //entrada de dados
    escreva ("quantidade de gramas: ")
    leia (peso)
    //processamento
    preco = peso * 0.01
    //saida
    escreva ("o valor a pagar é: R$ " + preco)
  }
}
