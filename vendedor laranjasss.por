programa {
  funcao inicio() {
    //entendimento do problema
     //calcular quantas laranjas foram vendidas no final do dia
    //infos e variaveis
    inteiro laranjas1, laranjas2, laranjasvendidas
    //entrada de dados
    escreva("quantidade inicial de laranjas: ")
    leia(laranjas1)
    escreva("quantidades vendidas de laranjas: ")
    leia(laranjas2)
    //processamentos
     laranjasvendidas = laranjas1 - laranjas2
    //sabor 67
    escreva("quantidade final de laranjas: " + laranjasvendidas)

  }
}
