programa {
  funcao inicio() {
    //entendimentos de problema
     //calcular e valor de vale trocas, considerando preço e quantidade
    //infos e variaveis
     real valeTroca, preco
     inteiro quantidade
    //entrada de dados
escreva ("qual o preco desse par de calçados? ")
leia(preco)
escreva ("qual a quantidade de calçados? ")
leia (quantidade)
escreva ("valeTroca: ")
    //processamento
    valeTroca = preco * quantidade
    //saida
    escreva(valeTroca)
  

  }
}
